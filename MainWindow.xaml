<Window x:Class="KeyTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyTile" Width="660" Height="860" MinWidth="580" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#101820" Foreground="#F2F6F8"
        FontFamily="Segoe UI" Icon="Assets/KeyTile.ico">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#A5B7C3" />
      <Setter Property="Background" Value="#192630" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,0,8,12">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#71E6C0" /><Setter Property="Foreground" Value="#102D2A" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#F2F6F8" /><Setter TargetName="TabBorder" Property="BorderThickness" Value="2" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#23323E" />
      <Setter Property="Foreground" Value="#F2F6F8" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#71E6C0" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#192630" /><Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="16,13" /><Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="Background" Value="#253643" /><Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,6" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid>
  <ScrollViewer x:Name="MainPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="30,26,30,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" Background="#71E6C0" CornerRadius="10" Margin="0,0,12,0">
            <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Background="#102D2A" CornerRadius="2" Margin="0,0,2,0" />
              <Border Grid.Column="1" BorderBrush="#102D2A" BorderThickness="2" CornerRadius="2" Margin="2,0,0,0" />
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="KeyTile" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="WINDOWS KEYBOARD PROTOTYPE" FontSize="10" Foreground="#90A7B7" /></StackPanel>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1A3832" CornerRadius="12" Padding="11,5">
          <TextBlock x:Name="StatusBadge" Text="ACTIVE" Foreground="#71E6C0" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,28,0,20">
        <TextBlock Text="A place for every window." FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Focus an app, then press a shortcut. KeyTile can stay in your tray." FontSize="13" Foreground="#A5B7C3" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
        <TabItem Header="Basics">
        <StackPanel TextElement.Foreground="#F2F6F8">
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="12" HorizontalAlignment="Left" Background="#71E6C0" CornerRadius="3,0,0,3" Margin="2" /></Grid>
          <StackPanel Grid.Column="1"><TextBlock Text="Left half" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="LeftStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="LeftShortcut" Text="Ctrl + Alt + ←" FontSize="13" FontFamily="Consolas" /></Border>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="12" HorizontalAlignment="Right" Background="#71E6C0" CornerRadius="0,3,3,0" Margin="2" /></Grid>
          <StackPanel Grid.Column="1"><TextBlock Text="Right half" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="RightStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="RightShortcut" Text="Ctrl + Alt + →" FontSize="13" FontFamily="Consolas" /></Border>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="27" Height="22" HorizontalAlignment="Left" BorderBrush="#71E6C0" BorderThickness="2" CornerRadius="3" />
          <StackPanel Grid.Column="1"><TextBlock Text="Maximize" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="MaximizeStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="MaximizeShortcut" Text="Ctrl + Alt + ↑" FontSize="13" FontFamily="Consolas" /></Border>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid Width="27" Height="25" HorizontalAlignment="Left"><Border Width="21" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="21" Height="17" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#192630" BorderBrush="#71E6C0" BorderThickness="2" CornerRadius="3" /></Grid>
          <StackPanel Grid.Column="1"><TextBlock Text="Restore" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="RestoreStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="RestoreShortcut" Text="Ctrl + Alt + ↓" FontSize="13" FontFamily="Consolas" /></Border>
        </Grid></Border>
        </StackPanel>
        </TabItem>
        <TabItem Header="Corners">
        <StackPanel TextElement.Foreground="#F2F6F8">
          <TextBlock Text="Four equal tiles on the current monitor." Foreground="#A5B7C3" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="10" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Top-left quarter" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TopLeftStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="TopLeftShortcut" Text="Ctrl + Alt + 1" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="10" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Top-right quarter" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="TopRightStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="TopRightShortcut" Text="Ctrl + Alt + 2" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="10" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Bottom-left quarter" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="BottomLeftStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="BottomLeftShortcut" Text="Ctrl + Alt + 3" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="10" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Bottom-right quarter" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="BottomRightStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="BottomRightShortcut" Text="Ctrl + Alt + 4" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
        </StackPanel>
        </TabItem>
        <TabItem Header="Thirds">
        <StackPanel TextElement.Foreground="#F2F6F8">
          <TextBlock Text="Three columns or a wider tile on the current monitor." Foreground="#A5B7C3" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="6" HorizontalAlignment="Left" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Left third" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="LeftThirdStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="LeftThirdShortcut" Text="Ctrl + Alt + 5" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="6" HorizontalAlignment="Center" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Center third" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="CenterThirdStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="CenterThirdShortcut" Text="Ctrl + Alt + 6" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="6" HorizontalAlignment="Right" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Right third" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="RightThirdStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="RightThirdShortcut" Text="Ctrl + Alt + 7" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="14" HorizontalAlignment="Left" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Left two-thirds" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="LeftTwoThirdsStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="LeftTwoThirdsShortcut" Text="Ctrl + Alt + 8" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="14" HorizontalAlignment="Right" Background="#71E6C0" CornerRadius="1" Margin="3" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Right two-thirds" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="RightTwoThirdsStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="RightTwoThirdsShortcut" Text="Ctrl + Alt + 9" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
        </StackPanel>
        </TabItem>
        <TabItem Header="Window Placement">
        <StackPanel TextElement.Foreground="#F2F6F8">
          <TextBlock Text="Center at the current size, or choose a centered size preset." Foreground="#A5B7C3" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#71E6C0" BorderThickness="2" CornerRadius="1" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Center · keep size" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="CenterStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="CenterShortcut" Text="Ctrl + Alt + Shift + C" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="11" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#71E6C0" CornerRadius="1" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Small · 50%" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="ResizeSmallStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="ResizeSmallShortcut" Text="Ctrl + Alt + Shift + S" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="15" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#71E6C0" CornerRadius="1" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Medium · 70%" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="ResizeMediumStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="ResizeMediumShortcut" Text="Ctrl + Alt + Shift + M" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="22" HorizontalAlignment="Left"><Border BorderBrush="#7892A5" BorderThickness="1" CornerRadius="3" /><Border Width="19" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#71E6C0" CornerRadius="1" /></Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="Large · 90%" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="ResizeLargeStatus" Text="Ready" FontSize="11" Foreground="#90A7B7" Margin="0,3,0,0" /></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Keycap}"><TextBlock x:Name="ResizeLargeShortcut" Text="Ctrl + Alt + Shift + L" FontSize="13" FontFamily="Consolas" /></Border>
          </Grid></Border>
          <TextBlock Text="Presets set both width and height to a percentage of the work area, then center the window." Foreground="#A5B7C3" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        </TabItem>
      </TabControl>
      <Border Grid.Row="3" Margin="0,10,0,18" Padding="13,11" BorderBrush="#2C414F" BorderThickness="1" CornerRadius="7">
        <TextBlock Text="Restore remembers the size, position, and state before your first placement change. Saved positions last for this session." Foreground="#A5B7C3" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
      </Border>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="PauseButton" Content="Pause shortcuts" HorizontalAlignment="Left" Click="Pause_Click" />
        <Button Grid.Column="1" Content="Hide to tray" Margin="0,0,8,0" Click="Hide_Click" Background="#71E6C0" Foreground="#102D2A" />
        <Button Grid.Column="2" Content="Exit" Click="Exit_Click" />
      </Grid>
      <StackPanel Grid.Row="5" Margin="0,16,0,0">
        <Button Content="Customize keyboard shortcuts" HorizontalAlignment="Left" Click="Customize_Click" Margin="0,0,0,16" />
        <CheckBox x:Name="StartupCheckBox" Content="Start KeyTile when I sign in" Foreground="#F2F6F8" FontSize="13"
                  Checked="Startup_Changed" Unchecked="Startup_Changed" />
        <TextBlock Text="Starts quietly in the tray, with your shortcuts ready." Foreground="#90A7B7" FontSize="11" Margin="20,5,0,0" />
      </StackPanel>
      <TextBlock Grid.Row="6" x:Name="ActivityText" Text="Ready. Switch to another app to try a shortcut." Foreground="#90A7B7" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="17" />
    </Grid>
  </ScrollViewer>
  <ContentControl x:Name="ShortcutEditorHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
